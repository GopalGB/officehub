# Copy to .env and fill in real values before first run.
# Never commit .env to git. The pre-push hook will block it.

# === Database ===
# Postgres connection string. Docker Compose sets this automatically when running via compose.
DATABASE_URL="postgresql://officehub:officehub@localhost:5432/officehub?schema=public"

# === Auth ===
# Generate with: openssl rand -base64 32
AUTH_SECRET="REPLACE_ME_WITH_32_BYTE_RANDOM_STRING"

# URL the app is reachable at - used by Auth.js for callbacks + cookies.
# In production set this to https://your-office-domain.com
NEXTAUTH_URL="http://localhost:3000"

# === First admin bootstrap ===
# These create the first admin user when prisma seed runs.
# Change BEFORE first deploy. Admin can then create users from the UI.
SEED_ADMIN_EMAIL="admin@office.local"
SEED_ADMIN_PASSWORD="ChangeMe!Now1234"
SEED_ADMIN_NAME="Office Admin"

# === Signup policy ===
# "closed" = only admin can create users (recommended for offices)
# "open"   = anyone can self-signup as MEMBER
SIGNUP_POLICY="closed"

# === Uploads ===
UPLOAD_DIR="./uploads"

# === Node ===
NODE_ENV="development"

# ============================================================================
# Feature flags (v2 — see config/features.ts for the full list + descriptions)
# Defaults match the registry. Set "false" to turn a feature off for a tenant.
# ============================================================================
FEATURE_TASKS="true"
FEATURE_WIKI="true"
FEATURE_CALENDAR="true"
FEATURE_PROJECT_BOARD="true"
FEATURE_FAVORITES="true"
FEATURE_ENHANCEMENTS="true"
FEATURE_COMMENTS="true"
FEATURE_TAGS="true"
FEATURE_CMD_K="true"
FEATURE_INVITATIONS="true"
FEATURE_DIRECT_PASSWORD="true"

# Deferred — not wired yet but reserve the flag
FEATURE_ATTACHMENTS="false"
FEATURE_AUDIT_LOG="false"
FEATURE_SSO="false"
FEATURE_EMAIL_DIGESTS="false"
FEATURE_SPRINTS="false"
FEATURE_REALTIME="false"

# ============================================================================
# White-label / branding (v2)
# ============================================================================
FEATURE_WHITELABEL="false"
BRAND_APP_NAME="OfficeHub"
BRAND_LOGO_URL="/logo.svg"
BRAND_PRIMARY="#000000"
BRAND_SUPPORT="support@office.local"
BRAND_LEGAL=""
