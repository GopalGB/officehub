{
  "name": "officehub",
  "version": "0.2.0",
  "private": true,
  "description": "Self-hosted Notion-like office workspace: projects, timelines, enhancements, manager rollup view.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@blocknote/core": "0.56.0",
    "@blocknote/mantine": "0.56.0",
    "@blocknote/react": "0.56.0",
    "@dnd-kit/core": "6.1.0",
    "@dnd-kit/sortable": "8.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@prisma/client": "5.22.0",
    "@radix-ui/react-dialog": "1.1.2",
    "@radix-ui/react-dropdown-menu": "2.1.2",
    "@radix-ui/react-label": "2.1.0",
    "@radix-ui/react-select": "2.1.2",
    "@radix-ui/react-slot": "1.1.0",
    "bcryptjs": "2.4.3",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "lucide-react": "0.460.0",
    "next": "15.5.28",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "2.5.4",
    "zod": "4.6.7",
    "@mantine/core": "8.3.18",
    "@mantine/hooks": "8.3.18"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.9.0",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.1",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.32",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.14",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "eslint": "^9.39.0",
    "@eslint/js": "^9.39.0",
    "typescript-eslint": "^8.60.0",
    "@next/eslint-plugin-next": "15.5.28",
    "eslint-plugin-security": "^3.0.1"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
